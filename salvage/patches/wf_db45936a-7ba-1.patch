+/// Render the Wind Tunnel workbench body (heading + fade-in scrollable
+/// sections) into an existing [`egui::Ui`]. Shared by the classic
+/// right-side [`draw_aero_workbench`] SidePanel and the docked-layout
+/// tile in [`crate::docking`].
+///
+/// NB: the background-run pump (`pump_aero_run`) is NOT called here — the
+/// classic path runs it in [`draw_aero_workbench`] before drawing, and
+/// the docked-layout path runs it once per frame (via
+/// [`pump_aero_run_external`]) before the tile tree is rendered. Keeping
+/// it out of the body avoids polling the channel twice in one frame.
+pub fn aero_workbench_body(app: &mut ValenxApp, ui: &mut egui::Ui) {
+    ui.horizontal(|ui| {
+        ui.heading("Wind Tunnel");
+    });
+    ui.label(
+        egui::RichText::new("Virtual wind tunnel — 3-D external-aerodynamics CFD")
+            .weak()
+            .small(),
+    );
+    ui.label(
+        egui::RichText::new("backed by `valenx-aero`")
+            .weak()
+            .small(),
+    );
+    ui.separator();
+
+    // Fade-in animation on workbench open — when the user
+    // toggles the workbench on via Ctrl+3 / View → Wind Tunnel
+    // the panel body fades in over 0.18 s rather than popping
+    // in instantly. The animation auto-resets when the panel
+    // closes.
+    let anim_id = egui::Id::new("valenx_aero_workbench_open");
+    let t = ui.ctx().animate_bool_with_time(anim_id, true, 0.18);
+    egui::ScrollArea::vertical()
+        .auto_shrink([false, false])
+        .show(ui, |ui| {
+            ui.scope(|ui| {
+                ui.set_opacity(t.clamp(0.0, 1.0));
+                panels::draw_body_section(app, ui);
+                panels::draw_wind_section(app, ui);
+                panels::draw_ground_section(app, ui);
+                panels::draw_tunnel_section(app, ui);
+                panels::draw_solver_section(app, ui);
+                panels::draw_run_section(app, ui);
+                panels::draw_results_section(app, ui);
+                panels::draw_visualization_section(app, ui);
+            });
         });
 }
 
+/// Poll the background wind-tunnel run from outside the workbench (used by
+/// the docked layout, which pumps once per frame before rendering the
+/// tile tree). Thin public wrapper over the module-private pump.
+pub fn pump_aero_run_external(app: &mut ValenxApp, ctx: &egui::Context) {
+    pump_aero_run(app, ctx);
+}
