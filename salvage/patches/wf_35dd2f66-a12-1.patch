+# egui_tiles: emilk's official tiling / docking crate for egui (the
+# same one Rerun uses). Powers the opt-in dockable / tileable tab
+# layout in valenx-app (src/docking.rs) — resizable row + column
+# splits, tab groups, close buttons, and drag-rearrange, all for free.
+# 0.9 is the release line whose egui dependency matches the workspace's
+# egui / eframe 0.28. License: MIT OR Apache-2.0 (already covered by
+# deny.toml's allow-list).
+egui_tiles = "0.9"
 # wgpu + bytemuck for the custom viewport render pipeline. eframe's
 # wgpu feature re-exports `eframe::wgpu` + `eframe::egui_wgpu`.
 bytemuck  = { version = "1", features = ["derive"] }
